# Required
DEEPSEEK_API_KEY=your-api-key

# DeepSeek API runtime
DEEPSEEK_BASE_URL=https://api.deepseek.com
# End-to-end deadline, including reading JSON bodies and streamed output
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
DEEPSEEK_DEFAULT_MODEL=deepseek-flash

# MCP transport: stdio | streamable-http
MCP_TRANSPORT=stdio

# Streamable HTTP mode
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
MCP_HTTP_PATH=/mcp
# Comma-separated browser origins. Requests without Origin (normal MCP clients) are unaffected.
MCP_HTTP_ALLOWED_ORIGINS=
# Shared bearer token for HTTP callers; required on non-loopback binds unless a
# trusted authenticated gateway is explicitly declared. Keep this secret.
MCP_HTTP_AUTH_TOKEN=
# Set true only behind a gateway that authenticates every MCP request.
MCP_HTTP_TRUST_AUTH_GATEWAY=false

# Maximum tool invocations per minute, shared across HTTP request instances
MCP_TOOL_RATE_LIMIT=120

# Conversation persistence
CONVERSATION_MAX_MESSAGES=200

# Hosted remote smoke test only (client-side)
DEEPSEEK_REMOTE_MCP_URL=https://deepseek-mcp.ragweld.com/mcp
DEEPSEEK_MCP_AUTH_TOKEN=your-hosted-token
